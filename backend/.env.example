# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/statarb_n50
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Market Data
MARKET_DATA_API_KEY=your_api_key_here
MARKET_DATA_PROVIDER=yahoo_finance
MARKET_DATA_CACHE_TTL=3600

# Real-time Data
REALTIME_DATA_PROVIDER=websocket
REALTIME_RECONNECT_INTERVAL=5
REALTIME_HEARTBEAT_INTERVAL=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Quantitative Engine
DEFAULT_CORRELATION_THRESHOLD=0.70
DEFAULT_COINT_P_VALUE=0.05
DEFAULT_ENTRY_Z_SCORE=2.0
DEFAULT_EXIT_Z_SCORE=0.0
DEFAULT_STOP_Z_SCORE=4.0
DEFAULT_HOLDING_PERIOD=30
DEFAULT_TRANSACTION_COST=0.10
DEFAULT_SLIPPAGE=0.05

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
